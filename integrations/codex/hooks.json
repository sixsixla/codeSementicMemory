{
  "description": "CodeMemory automatic coding-memory loop",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -X utf8 \"D:\\Tool\\codeSementicMemory\\integrations\\codex\\codememory_hook.py\"",
            "timeout": 10,
            "statusMessage": "Opening CodeMemory cycle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -X utf8 \"D:\\Tool\\codeSementicMemory\\integrations\\codex\\codememory_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 4000,
            "statusMessage": "Loading CodeMemory route hints"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -X utf8 \"D:\\Tool\\codeSementicMemory\\integrations\\codex\\codememory_hook.py\"",
            "async": true,
            "timeout": 30,
            "statusMessage": "Capturing CodeMemory tool evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -X utf8 \"D:\\Tool\\codeSementicMemory\\integrations\\codex\\codememory_hook.py\"",
            "timeout": 20,
            "statusMessage": "Updating CodeMemory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -X utf8 \"D:\\Tool\\codeSementicMemory\\integrations\\codex\\codememory_hook.py\"",
            "timeout": 3,
            "statusMessage": "Closing CodeMemory cycle"
          }
        ]
      }
    ]
  }
}
